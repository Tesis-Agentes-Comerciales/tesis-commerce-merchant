# Copie este archivo a .env solo si arranca el comercio a mano; demo-stack no lo necesita.
# Todo es sintético y local. Los valores son los predeterminados; una línea comentada queda sin
# definir, y así lo que depende de ella falla cerrado.

# PostgreSQL de compose.yaml, solo en 127.0.0.1. Si cambia el puerto, cámbielo en ambas líneas.
DATABASE_URL=postgresql://tesis_dev:tesis_local_only@127.0.0.1:55433/tesis_lab
MERCHANT_PG_PORT=55433
# Origen público del comercio; fuera de localhost exige HTTPS.
ACP_API_BASE_URL=http://127.0.0.1:4120

# Proveedor de pagos sandbox. Sin el token, /complete responde que el proveedor no está disponible.
PAYMENT_PROVIDER_URL=http://127.0.0.1:4130
PAYMENT_MERCHANT_ID=tesis_merchant
# PAYMENT_MERCHANT_BEARER_TOKEN=

# AP2: clave EC P-256 privada del comercio, en PEM. Sin ella, las rutas /ap2/* fallan cerrado.
# MERCHANT_AP2_PRIVATE_KEY_PEM=
# Con true, /complete se rechaza y la compra exige un mandato firmado por el agente.
# MERCHANT_AP2_REQUIRED=true
# MERCHANT_AP2_AGENT_JWK_JSON={"kty":"EC","crv":"P-256","x":"...","y":"..."}

# Webhooks de órdenes: origen del agente, sin la ruta, y el secreto que comparte con él.
# WEBHOOK_RECEIVER_URL=
# MERCHANT_WEBHOOK_SECRET=
